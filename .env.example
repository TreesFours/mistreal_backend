# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/mistreal
APP_URL=https://mistreal-backend.onrender.com
FREE_USER_PLATFORM_LIMIT=1

# ==========================================
# Instagram (Graph API v18.0)
# Get from: https://developers.facebook.com/
# ==========================================
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

# ==========================================
# Twitter/X (API v2 OAuth 2.0)
# Get from: https://developer.twitter.com/
# ==========================================
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# ==========================================
# Facebook (Graph API v18.0)
# Get from: https://developers.facebook.com/
# ==========================================
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# ==========================================
# WhatsApp (Business API)
# Get from: https://developers.facebook.com/
# ==========================================
WHATSAPP_CLIENT_ID=your_whatsapp_app_id
WHATSAPP_CLIENT_SECRET=your_whatsapp_app_secret

# ==========================================
# LinkedIn (OAuth 2.0)
# Get from: https://www.linkedin.com/developers/
# ==========================================
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ==========================================
# Telegram (Bot API)
# Get from: https://t.me/botfather
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ==========================================
# AI Services
# ==========================================
OPENROUTER_API_KEY=your_openrouter_key_here
GEMINI_API_KEY=your_gemini_key_here

# ==========================================
# News & Weather APIs
# ==========================================
OPENWEATHER_API_KEY=your_openweather_key_here

# ==========================================
# Places / Discovery (Map labeling)
# Get a free key (3,000 req/day, no card needed) from: https://myprojects.geoapify.com/
# ==========================================
GEOAPIFY_API_KEY=your_geoapify_key_here
NEWSAPI_KEY=your_newsapi_key_here

# ==========================================
# Payments (Stripe)
# ==========================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# ==========================================
# Firebase
# ==========================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_service_account_email

# ==========================================
# Redis (Optional Caching)
# ==========================================
REDIS_URL=redis://default:password@your-redis-host:port
