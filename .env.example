# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/mistreal

# ==========================================
# Instagram (Graph API v18.0)
# ==========================================
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=https://yourdomain.com/api/social/callback/instagram

# ==========================================
# Twitter (API v2)
# ==========================================
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=https://yourdomain.com/api/social/callback/twitter

# ==========================================
# Facebook (Graph API v18.0)
# ==========================================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://yourdomain.com/api/social/callback/facebook

# ==========================================
# WhatsApp (Cloud API)
# ==========================================
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_URL=https://yourdomain.com/api/social/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ==========================================
# Telegram (Bot API)
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/social/telegram/webhook

# ==========================================
# AI Services
# ==========================================
OPENROUTER_API_KEY=your_openrouter_key_here
GEMINI_API_KEY=your_gemini_key_here

# ==========================================
# News & Weather APIs
# ==========================================
OPENWEATHER_API_KEY=your_openweather_key_here
NEWSAPI_KEY=your_newsapi_key_here

# ==========================================
# Payments (Stripe)
# ==========================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# ==========================================
# Firebase
# ==========================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_service_account_email

# ==========================================
# Payments (Legacy - Google Play Billing)
# ==========================================
MISTREAL_PRO_PRICE_USD=14.99
MISTREAL_PRO_PRODUCT_ID=mistreal_pro_monthly
MISTREAL_FREE_TRIAL_DAYS=0

# ==========================================
# Redis (Optional Caching)
# ==========================================
REDIS_URL=redis://default:password@your-redis-host:port
