# ==========================================
# Server Configuration (required)
# ==========================================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/mistreal
APP_URL=https://mistreal-backend.onrender.com
FREE_USER_PLATFORM_LIMIT=1
PREMIUM_1_PLATFORM_LIMIT=5
PREMIUM_2_PLATFORM_LIMIT=99
REDIS_URL=redis://default:password@your-redis-host:port

# ==========================================
# Firebase Admin (required — auth won't work without it)
# One JSON blob, not three separate fields. In the Firebase console:
# Project Settings > Service Accounts > Generate new private key, then
# paste the ENTIRE downloaded JSON file as a single-line value here.
# Get from: https://console.firebase.google.com/ (your project > gear icon > Project settings > Service accounts)
# ==========================================
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# ==========================================
# BYOK key encryption (required — the bring-your-own-AI-key feature throws
# an error at runtime without this, it does not silently skip).
# Generate with: openssl rand -base64 32
# ==========================================
BYOK_ENCRYPTION_KEY=

# ==========================================
# Core AI (required for chat to work at all)
# Gemini: https://aistudio.google.com/app/apikey (free tier available)
# OpenRouter: https://openrouter.ai/keys (needed for GPT-4/Claude/Llama/etc. model options)
# ==========================================
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# ==========================================
# Payments (required for subscriptions to work)
# Get from: https://dashboard.stripe.com/apikeys  (webhook secret: https://dashboard.stripe.com/webhooks)
# ==========================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret
PRO_PRICE=$9.99/mo
PRO_PRODUCT_ID=pro_monthly_subscription
FREE_TRIAL_DAYS=7
STRIPE_PRICE_AI_PLUS=price_xxx
STRIPE_PRICE_SOCIAL_PLUS=price_xxx
STRIPE_PRICE_ELITE=price_xxx

# ==========================================
# Social platform OAuth (each one optional — that platform's connect flow
# just won't work until its pair is set; nothing else breaks)
# Instagram/Facebook/WhatsApp: https://developers.facebook.com/
# Twitter/X: https://developer.twitter.com/
# LinkedIn: https://www.linkedin.com/developers/
# ==========================================
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
WHATSAPP_CLIENT_ID=your_whatsapp_app_id
WHATSAPP_CLIENT_SECRET=your_whatsapp_app_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ==========================================
# YouTube native posting (bypasses Zernio — it has no YouTube upload
# capability at all). Register an OAuth 2.0 Client ID (type "Web application")
# in Google Cloud Console, and add this exact Authorized redirect URI:
#   https://mistreal-backend.onrender.com/api/social/youtube/callback
# Required for the "connect YouTube" flow to do anything beyond error —
# everything else about YouTube (the curated read-only feed via YOUTUBE_API_KEY
# below) keeps working without this.
# Get from: https://console.cloud.google.com/apis/credentials
# Note: Google requires a one-time, free app verification review (a few
# weeks) before upload works for the general public — up to 100 test users
# can use it immediately while that's pending.
# ==========================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ==========================================
# Zernio (the social-platform aggregator the app's DM/contacts/posting
# features actually go through) — required for any social feature to work.
# Get from: whoever issued your Zernio account/API credentials.
# ==========================================
ZERNIO_API_KEY=your_zernio_api_key
ZERNIO_WEBHOOK_SECRET=your_zernio_webhook_secret

# ==========================================
# Intelligence feed — all optional; each one's feed category just stays
# empty (or shows a small hardcoded fallback) without its key. The exact
# variable name matters — NEWS_API_KEY, not NEWSAPI_KEY.
# NewsAPI (news articles): https://newsapi.org/register — free tier: 100 req/day
# OpenWeather (weather + feeds into astro enrichment): https://home.openweathermap.org/users/sign_up
# AstronomyAPI (moon phase/astro feed items): https://astronomyapi.com/ (sign up for an App ID + App Secret pair)
# NASA API (celestial body tracking, JPL Horizons doesn't strictly need this but it's polite to set): https://api.nasa.gov/
# TheSportsDB (live scores): https://www.thesportsdb.com/api.php — free tier works without a key (defaults to test key '3'); get your own for production use
# YouTube Data API (curated video feed): https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3" first)
# ==========================================
NEWS_API_KEY=your_newsapi_key_here
OPENWEATHER_API_KEY=your_openweather_key_here
ASTRONOMY_API_ID=your_astronomyapi_app_id
ASTRONOMY_API_SECRET=your_astronomyapi_app_secret
NASA_API_KEY=your_nasa_api_key
SPORTSDB_API_KEY=your_thesportsdb_key
YOUTUBE_API_KEY=your_youtube_data_api_key

# ==========================================
# Market data feed + price alerts — optional; without TWELVE_DATA_API_KEY,
# stock/commodity quotes return empty (crypto via CoinGecko needs no key).
# Twelve Data: https://twelvedata.com/pricing — free tier: 800 req/day
# ==========================================
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# ==========================================
# Map/Discovery — optional, used for place lookups and location photos.
# Geoapify (free, 3,000 req/day, no card needed): https://myprojects.geoapify.com/
# Google Places (better photo quality, needs billing enabled): https://console.cloud.google.com/google/maps-apis/credentials
# Pexels (free fallback photo source, no billing): https://www.pexels.com/api/
# ==========================================
GEOAPIFY_API_KEY=your_geoapify_key_here
GOOGLE_PLACES_API_KEY=your_google_places_key_here
PEXELS_API_KEY=your_pexels_key_here

# ==========================================
# Email send (Settings > Email compose feature) — optional, uses Gmail SMTP.
# GMAIL_APP_PASS is a 16-character App Password, NOT your normal Gmail
# password — generate one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account first)
# ==========================================
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASS=your_16_char_app_password

# ==========================================
# Ads — optional, defaults to 6 if unset.
# ==========================================
AD_APPEARANCES_PER_12H=6
